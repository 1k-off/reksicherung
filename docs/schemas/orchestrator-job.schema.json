{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reksicherung.1node.xyz/schemas/orchestrator-job.schema.json",
  "title": "Orchestrator restore-check job fragment",
  "description": "Runtime-agnostic job shape: MCP servers + skills (+ optional prompts). One compatible binding is examples/airon/restore-check.yaml.",
  "type": "object",
  "required": ["mcp_servers", "skills"],
  "properties": {
    "runtime": {
      "type": "object",
      "properties": {
        "log_inputs": { "type": "boolean" },
        "outcome": { "type": "string" }
      }
    },
    "mcp_servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "transport", "command", "env_passthrough"],
        "properties": {
          "name": { "type": "string" },
          "transport": { "const": "stdio" },
          "command": { "type": "string" },
          "env_passthrough": { "const": false },
          "env": {
            "type": "object",
            "description": "Bootstrap only: OpenBao addr/token, optional path overrides, and inspect DATABASE. SQL HOST/USERNAME/PASSWORD come from OpenBao. No per-backup S3 keys.",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": { "path": { "type": "string" } }
      }
    },
    "prompts": { "type": "array" }
  }
}
