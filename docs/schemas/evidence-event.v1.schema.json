{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reksicherung.1node.xyz/schemas/evidence-event.v1.schema.json",
  "title": "Evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "timestamp", "operation", "status"],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "operation": { "type": "string" },
    "status": {
      "enum": ["started", "succeeded", "failed", "canceled", "skipped"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "error": { "type": "string" }
  }
}
