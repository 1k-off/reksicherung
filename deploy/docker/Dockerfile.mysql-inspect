# syntax=docker/dockerfile:1.7
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/reksicherung-mcp-mysql ./cmd/reksicherung-mcp-mysql

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/reksicherung-mcp-mysql /usr/local/bin/reksicherung-mcp-mysql
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/reksicherung-mcp-mysql"]
