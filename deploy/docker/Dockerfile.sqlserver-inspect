# syntax=docker/dockerfile:1.7
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/reksicherung-mcp-sqlserver ./cmd/reksicherung-mcp-sqlserver

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/reksicherung-mcp-sqlserver /usr/local/bin/reksicherung-mcp-sqlserver
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/reksicherung-mcp-sqlserver"]
