# Bootstrap-only compose environment.
# SQL connection (HOST/PORT/USERNAME/PASSWORD) lives in OpenBao:
#   secret/reksicherung/sqlserver
# Schema: docs/schemas/compose-env.schema.json

# SQL Server container bootstrap (SA only for creating the restore login)
MSSQL_SA_PASSWORD=ReplaceWithStrongPassword_123

# MySQL container bootstrap. OPT-IN via compose profile `mysql`: plain
# `docker compose up` does not start mysql / mysql-restore-mcp / mysql-inspect-mcp.
# Uncomment and set only when using database.type=mysql sources, then run:
#   docker compose --env-file .env --profile mysql up -d mysql
# Connection used by MCP/reconciler lives in OpenBao: secret/reksicherung/mysql
# MYSQL_ROOT_PASSWORD=ReplaceWithStrongPassword_123

# OpenBao bootstrap (operator-managed; replace after init/unseal)
REKSICHERUNG_OPENBAO_ADDR=http://127.0.0.1:8200
REKSICHERUNG_OPENBAO_TOKEN=replace-after-init

# Published image tag for ghcr.io/1k-off/reksicherung/* (operators: pull, do not build)
# REKSICHERUNG_IMAGE_TAG=latest

# Optional path overrides (built-in defaults usually suffice)
# REKSICHERUNG_ARTIFACT_STAGE_DIR=/var/lib/reksicherung/artifacts
# REKSICHERUNG_SQLSERVER_BACKUP_DIR=/var/opt/mssql/backup
# REKSICHERUNG_SQLSERVER_DATA_DIR=/var/opt/mssql/data
# REKSICHERUNG_ARTIFACT_MAX_BYTES=214748364800
