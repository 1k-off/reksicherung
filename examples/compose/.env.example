# Copy to .env and replace before starting compose.
# Never commit real secrets.

COMPOSE_PROJECT_NAME=reksicherung

# SQL Server restore target (isolated network only)
MSSQL_SA_PASSWORD=ReplaceWithStrongPassword_123
REKSICHERUNG_SQLSERVER_RESTORE_USERNAME=reksicherung_restore
REKSICHERUNG_SQLSERVER_RESTORE_PASSWORD=ReplaceWithStrongPassword_456

# OpenBao bootstrap (operator-managed; replace after init/unseal)
REKSICHERUNG_OPENBAO_ADDR=http://openbao:8200
REKSICHERUNG_OPENBAO_TOKEN=replace-after-init

# Secret references stored in OpenBao KV v2
REKSICHERUNG_SQLSERVER_RESTORE_PASSWORD_REF=openbao://secret/reksicherung/sqlserver#restore-password
REKSICHERUNG_GOBACKUP_S3_ACCESS_KEY_REF=openbao://secret/reksicherung/s3#access-key
REKSICHERUNG_GOBACKUP_S3_SECRET_KEY_REF=openbao://secret/reksicherung/s3#secret-key
REKSICHERUNG_RESTIC_PASSWORD_REF=openbao://secret/reksicherung/restic#repository-password
REKSICHERUNG_RESTIC_AWS_ACCESS_KEY_ID_REF=openbao://secret/reksicherung/s3#access-key
REKSICHERUNG_RESTIC_AWS_SECRET_ACCESS_KEY_REF=openbao://secret/reksicherung/s3#secret-key

# Storage coordinates (no secret values)
REKSICHERUNG_GOBACKUP_S3_ENDPOINT=https://minio.example.test
REKSICHERUNG_GOBACKUP_S3_REGION=eu-central
REKSICHERUNG_GOBACKUP_S3_BUCKET=backup-data
REKSICHERUNG_GOBACKUP_S3_PREFIX=example/production/
REKSICHERUNG_RESTIC_REPOSITORY=s3:https://minio.example.test/backup-data/restic/example
AWS_DEFAULT_REGION=eu-central

# Shared paths inside containers
REKSICHERUNG_ARTIFACT_STAGE_DIR=/var/lib/reksicherung/artifacts
REKSICHERUNG_SQLSERVER_BACKUP_DIR=/var/opt/mssql/backup
REKSICHERUNG_SQLSERVER_DATA_DIR=/var/opt/mssql/data
REKSICHERUNG_ARTIFACT_MAX_BYTES=214748364800
