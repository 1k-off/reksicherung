# Copy to .env (never commit).

# Public hostname (A/AAAA → this host). Used by Traefik Host() + OpenBao api_addr.
OPENBAO_HOST=bao.example.com

# Host HTTPS port for Traefik (keep 80/443 free for other stacks).
OPENBAO_HTTPS_PORT=8443

# Let's Encrypt account email + Cloudflare DNS-01 API token
# (Cloudflare → My Profile → API Tokens → Create Token;
#  permissions: Zone.DNS Edit on the zone that holds OPENBAO_HOST).
TRAEFIK_ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=

# CIDRs allowed to hit / and /ui (Traefik IP allowlist). /v1 stays token-auth only.
# Example: 203.0.113.10/32,198.51.100.0/24
OPENBAO_UI_ALLOWLIST=

TRAEFIK_LOG_LEVEL=WARN
